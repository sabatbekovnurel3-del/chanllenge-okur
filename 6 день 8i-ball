import random
import time
answers = [
    "Бесспорно.",
    "Как я вижу, да.",
    "Безусловно.",
    "Da, определённо.",
    "Можешь быть уверен в этом.",
    "По моим данным — да.",
    "Мутно всё это, попробуй снова.",
    "Спроси позже.",
    "Лучше не рассказывать тебе сейчас.",
    "Сейчас нельзя предсказать.",
    "Даже не думай.",
    "Мой ответ — нет.",
    "По моим данным — нет.",
    "Перспективы не очень хорошие.",
    "Весьма сомнительно."]
def think():
    """Эффект раздумья — три точки с задержкой."""
    print("Шар думает", end="", flush=True)
    for _ in range(3):
        time.sleep(0.6)
        print(".", end="", flush=True)
    time.sleep(0.5)
    print()  
def ask_the_ball():
    """Основная логика: спросить вопрос и дать случайный ответ."""
    print("=" * 40)
    print("   🎱 МАГИЧЕСКИЙ ШАР ПРЕДСКАЗАНИЙ")
    print("=" * 40)
    print("Задай вопрос, на который можно ответить 'да' или 'нет'.")
    print("Для выхода введи 'q'\n")
    while True:
        question = input("Твой вопрос: ")
        if question.lower() == 'q':
            print("\nШар прощается с тобой!")
            break
        if question.strip() == "":
            print("Нужно задать вопрос!\n")
            continue
        think()
        answer = random.choice(answers)
        print(f"🎱 Шар говорит: {answer}\n")
if __name__ == "__main__":
    ask_the_ball()

