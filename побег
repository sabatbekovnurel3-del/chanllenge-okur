import time
def slow_print(text, delay=0.03):
    """Печатает текст постепенно, как в настоящих квестах."""
    for char in text:
        print(char, end="", flush=True)
        time.sleep(delay)
    print()
def get_choice(option1, option2):
    """Спрашивает у игрока выбор 1 или 2, пока не введёт корректно."""
    while True:
        choice = input("\nТвой выбор (1/2): ")
        if choice in ("1", "2"):
            return choice
        print("Введи 1 или 2!")
def ending_good():
    slow_print("\n🎉 ХОРОШАЯ КОНЦОВКА: СВОБОДА!")
    slow_print("Ты незаметно выскальзываешь через чёрный ход и оказываешься на улице.")
    slow_print("Директор так и не узнал, что ты был в здании после уроков.")
    slow_print("Ты — легенда лицея.\n")
def ending_bad():
    slow_print("\n💀 ПЛОХАЯ КОНЦОВКА: ПОЙМАН!")
    slow_print("Директор хватает тебя за плечо прямо у выхода.")
    slow_print("«Так-так-так... Завтра жду с родителями», — говорит он с улыбкой.")
    slow_print("Твой побег с треском провалился.\n")
def ending_neutral():
    slow_print("\n😐 НЕЙТРАЛЬНАЯ КОНЦОВКА: ЗАСТРЯЛ")
    slow_print("Ты прячешься в кабинете труда до самого вечера.")
    slow_print("Охранник находит тебя, когда закрывает лицей, и просто выпускает домой.")
    slow_print("Побег не удался, но и не провалился. Ничья.\n")
def scene_library():
    """Сцена в библиотеке — один из путей ко второй развилке."""
    slow_print("\nТы проскальзываешь в библиотеку. Тихо и пусто.")
    slow_print("В углу ты замечаешь открытое окно на первом этаже.")
    slow_print("Но рядом, у стеллажей, слышны чьи-то шаги...")
    print("\n1 — Тихо вылезти через окно")
    print("2 — Спрятаться за стеллажами и подождать")
    choice = get_choice("окно", "спрятаться")
    if choice == "1":
        ending_good()
    else:
        slow_print("\nШаги затихают — это была просто уборщица.")
        slow_print("Но ты потерял время, и скоро прозвенит звонок охраны...")
        ending_neutral()
def scene_office():
    """Сцена рядом с кабинетом директора."""
    slow_print("\nТы идёшь по коридору к кабинету директора.")
    slow_print("Дверь приоткрыта — оттуда доносится голос по телефону.")
    slow_print("Дальше по коридору — запасной выход с сигнализацией.")
    print("\n1 — Проскочить мимо кабинета к запасному выходу")
    print("2 — Развернуться и поискать другой путь")
    choice = get_choice("выход", "другой путь")
    if choice == "1":
        slow_print("\nТы почти пробегаешь мимо, но директор выглядывает из кабинета!")
        ending_bad()
    else:
        slow_print("\nТы разворачиваешься и идёшь в сторону библиотеки.")
        scene_library()
def scene_start():
    """Стартовая сцена квеста."""
    slow_print("=" * 50)
    slow_print("   ПОБЕГ ИЗ ЛИЦЕЯ")
    slow_print("=" * 50)
    slow_print("\nУроки закончились, но тебя случайно заперли в здании.")
    slow_print("Перед тобой развилка коридора:")
    slow_print("налево — столовая, направо — кабинет директора.")
    print("\n1 — Идти в столовую")
    print("2 — Идти к кабинету директора")
    choice = get_choice("столовая", "кабинет")
    if choice == "1":
        slow_print("\nВ столовой темно и пусто. Повариха уже ушла домой.")
        slow_print("Ты замечаешь дверь на кухню — оттуда, кажется, есть выход на задний двор.")
        slow_print("Но дверь может быть заперта...")
        print("\n1 — Рискнуть и пойти через кухню")
        print("2 — Вернуться и попробовать другой путь")
        choice2 = get_choice("кухня", "вернуться")
        if choice2 == "1":
            ending_good()
        else:
            scene_office()
    else:
        scene_office()
def main():
    play_again = "1"
    while play_again == "1":
        scene_start()
        print("\n" + "=" * 50)
        print("1 — Сыграть ещё раз")
        print("2 — Выйти")
        play_again = get_choice("ещё раз", "выйти")
    slow_print("\nСпасибо за игру!")
if __name__ == "__main__":
    main()
