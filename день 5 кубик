import random
import time
DICE_FACES = {
    1: [
        "┌─────────┐",
        "│         │",
        "│    ●    │",
        "│         │",
        "└─────────┘"
    ],
    2: [
        "┌─────────┐",
        "│  ●      │",
        "│         │",
        "│      ●  │",
        "└─────────┘"
    ],
    3: [
        "┌─────────┐",
        "│  ●      │",
        "│    ●    │",
        "│      ●  │",
        "└─────────┘"
    ],
    4: [
        "┌─────────┐",
        "│  ●   ●  │",
        "│         │",
        "│  ●   ●  │",
        "└─────────┘"
    ],
    5: [
        "┌─────────┐",
        "│  ●   ●  │",
        "│    ●    │",
        "│  ●   ●  │",
        "└─────────┘"
    ],
    6: [
        "┌─────────┐",
        "│  ●   ●  │",
        "│  ●   ●  │",
        "│  ●   ●  │",
        "└─────────┘"
    ],}
def animate_roll(sides, duration=1.5):
    """
    Показывает анимацию "кручения" кубика — быстро меняющиеся
    случайные числа, прежде чем показать финальный результат.
    """
    steps = 15 
    delay = duration / steps

    for i in range(steps):
        fake_number = random.randint(1, sides)

       
        current_delay = delay * (1 + i / steps)

        print(f"\r🎲 Бросаю... {fake_number}   ", end="", flush=True)
        time.sleep(current_delay)

    print("\r" + " " * 20, end="\r")  
def show_dice_face(number):
    """Показывает картинку кубика для граней 1-6."""
    for line in DICE_FACES[number]:
        print(line)
def roll_single_die(sides=6):
    """Бросок одного кубика с анимацией."""
    animate_roll(sides)
    result = random.randint(1, sides)

    if sides == 6:
        show_dice_face(result)

    print(f"\n>>> Выпало: {result} <<<\n")
    return result
def roll_multiple_dice(count, sides):
    """Бросок нескольких кубиков одновременно."""
    print(f"\nБросаю {count} кубиков по {sides} граней...")
    animate_roll(sides)

    results = [random.randint(1, sides) for _ in range(count)]
    total = sum(results)

    print(f"Результаты броска: {results}")
    print(f">>> Сумма: {total} <<<\n")
    return results, total
def show_menu():
    print("=" * 40)
    print("   СИМУЛЯТОР ИГРАЛЬНЫХ КОСТЕЙ")
    print("=" * 40)
    print("1 — Обычный кубик (d6)")
    print("2 — Кубик для RPG (d20)")
    print("3 — Свой кубик (укажи количество граней)")
    print("4 — Несколько кубиков сразу")
    print("5 — Выход")
    return input("Выбери пункт (1-5): ")
def main():
    while True:
        choice = show_menu()
        print()
        if choice == "1":
            roll_single_die(6)
        elif choice == "2":
            print("🎲 Бросок d20 для RPG!")
            result = roll_single_die(20)
            if result == 20:
                print("★ КРИТИЧЕСКИЙ УСПЕХ! ★\n")
            elif result == 1:
                print("✗ КРИТИЧЕСКИЙ ПРОВАЛ ✗\n")
        elif choice == "3":
            sides = int(input("Сколько граней у кубика? "))
            roll_single_die(sides)
        elif choice == "4":
            count = int(input("Сколько кубиков бросить? "))
            sides = int(input("Сколько граней у каждого? "))
            roll_multiple_dice(count, sides)
        elif choice == "5":
            print("До свидания!")
            break
        else:
            print("Некорректный выбор. Попробуй снова.\n")
if __name__ == "__main__":
    main()
